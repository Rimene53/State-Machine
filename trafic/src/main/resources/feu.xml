<scxml xmlns="http://www.w3.org/2005/07/scxml" initial="rouge" version="1.0">

    <datamodel>
        <data name="duration" expr="0"/>
    </datamodel>

    <state id="rouge">
        <onentry>
            <assign name="duration" expr="2" />
        </onentry>
        <transition event="com.example.specifique.TraficFunctional::next" target="orange" />
    </state>

    <state id="orange">
        <onentry>
            <assign name="duration" expr="3" />
        </onentry>
        <transition event="com.example.specifique.TraficFunctional::next" target="vert" />
    </state>

    <state id="vert">
        <onentry>
            <assign name="duration" expr="15" />
        </onentry>
        <transition event="com.example.specifique.TraficFunctional::next" target="stop"/>
    </state>
    <final id="stop"/>
</scxml>
